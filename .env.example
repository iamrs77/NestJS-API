# Copy this file to .env before you start the API.
# The values below work with the database in docker-compose.yml.

# Where the PostgreSQL database is
DATABASE_URL="postgresql://postgres:123@localhost:5434/nest?schema=public"

# Secret used to sign login tokens. Change it to a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on
PORT=3000
